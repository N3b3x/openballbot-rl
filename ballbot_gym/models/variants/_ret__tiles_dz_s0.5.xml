<mujoco model="ballbot">
  <compiler meshdir="../meshes" texturedir="../textures" /> 
  <option timestep="0.002" />
  <option cone="elliptic" />
  <option integrator="RK4" />

  <visual>
    <map znear="0.0001" zfar="1.0" />
    <global offwidth="640" offheight="640" />
  </visual> 


  <asset>
    <mesh name="cone_mesh" file="cone.stl" scale="0.005 0.005 0.005" /> 
   
    <texture name="grid" type="2d" builtin="checker" rgb1=".1 .2 .3" rgb2=".2 .3 .4" width="300" height="300" />
    <material name="grid" texture="grid" texrepeat="8 8" reflectance=".8" shininess="0.8" />
    
    <texture name="floor_chk" type="2d" builtin="checker" rgb1=".85 .85 .85" rgb2=".25 .25 .28" width="512" height="512" />
    <material name="floor_chk" texture="floor_chk" texrepeat="20 20" reflectance="0.05" />
    
    <texture name="basketball_tex" type="2d" file="basketball_texture.png" />
    <material name="basketball_mat" texture="basketball_tex" shininess="0.2" />

    
    <hfield name="terrain" nrow="707" ncol="707" size="12.0 12.0 2.0 0.1" />
  </asset>


  <worldbody>

    <light name="top" pos="0 0 10.0" />

    
    
    <camera name="world_view" mode="fixed" pos="0 -1 0.75" euler="0 15 0" fovy="60" />

    <geom name="terrain" type="hfield" hfield="terrain" size="12.0 12.0 0.1" pos="0 0 0" material="floor_chk" />
    
    
    <body name="base" pos="0 0 0.12" euler="0 0 0">
    
      <freejoint name="base_free_joint" />
      <geom name="arrestor_0" type="sphere" size="0.0080" pos="0.01146 0.05092 -0.07362" density="0" contype="0" conaffinity="0" rgba="0.85 0.85 0.9 1" group="1"/>
      <geom name="arrestor_1" type="sphere" size="0.0080" pos="-0.04983 -0.01554 -0.07362" density="0" contype="0" conaffinity="0" rgba="0.85 0.85 0.9 1" group="1"/>
      <geom name="arrestor_2" type="sphere" size="0.0080" pos="0.03837 -0.03539 -0.07362" density="0" contype="0" conaffinity="0" rgba="0.85 0.85 0.9 1" group="1"/>
      <geom name="tower_collision" type="cylinder" size="0.055 0.07" pos="0 0 0.1" density="23.6" rgba="0.18 0.8 0.44 1.0" /> 
      <geom name="ballast" type="box" size="0.05 0.05 0.05" rgba="0.5 0.5 0.0 0.5" density="400" pos="0 0 0.001" contype="0" conaffinity="0" group="3" />   to lower center of mass

      <body name="cam_0_body" pos="0.085 -0.005 -0.03" euler="180 -30 0">
        <geom name="cam_0_geom" type="mesh" mesh="cone_mesh" rgba="1.0 1.0 0.0 1.0" density="1.0" pos="0 0 0" />  
        <geom name="cam_0_stick" type="capsule" fromto="0 0 0 -0.1 0 0" size="0.005 0.0025" rgba="0.18 0.8 0.44 1" />--&gt;
        <camera name="cam_0" pos="0 0 0" euler="180 0 0" fovy="90" />
      </body>

      <body name="cam_1_body" pos="-0.085 -0.005 -0.03" euler="180 30 0">
        <geom name="cam_1_geom" type="mesh" mesh="cone_mesh" rgba="1.0 1.0 0.0 1.0" density="1.0" pos="0 0 0" />  
        <geom name="cam_1_stick" type="capsule" fromto="0 0 0 0.1 0 0" size="0.005 0.0025" rgba="0.18 0.8 0.44 1" />--&gt;
        <camera name="cam_1" pos="0 0 0" euler="180 0 0" fovy="90" />
      </body>

      <body name="wheel_0" pos="0 0 -0.0005" euler="0 0 0">
         <geom name="wheel_mesh_0" type="capsule" size="0.0125 0.01" euler="-45 9 0" pos="-0.009 -0.04 -0.0265" density="620.0" rgba="1 0 0 1" material="grid" />
        <joint name="wheel_joint_0" type="hinge" axis="-0.15316554764123935 -0.6903189805903613 -0.7071067953657663" pos="0 0 0.01465" armature="0.00015625" damping="0.01767767" />
      </body>

      <body name="wheel_1" pos="0 0 -0.0005" euler="0 0 120">
        <geom name="wheel_mesh_1" type="capsule" size="0.0125 0.01" euler="-45 9 0" pos="-0.009 -0.04 -0.0265" density="620.0" rgba="0 1 0 1" material="grid" />
        <joint name="wheel_joint_1" type="hinge" axis="-0.15316554764123935 -0.6903189805903613 -0.7071067953657663" pos="0 0 0.01465" armature="0.00015625" damping="0.01767767" />
      </body>


      <body name="wheel_2" pos="0 0 -0.0005" euler="0 0 240">
        <geom name="wheel_mesh_2" type="capsule" size="0.0125 0.01" euler="-45 9 0" pos="-0.009 -0.04 -0.0265" density="620.0" rgba="0 0 1 1" material="grid" />
        <joint name="wheel_joint_2" type="hinge" axis="-0.15316554764123935 -0.6903189805903613 -0.7071067953657663" pos="0 0 0.01465" armature="0.00015625" damping="0.01767767" />
      </body>

      <site name="imu_site" pos="0 0 0" size="0.005" />

    </body>

    <body name="ball" pos="0 0 0.13">
      <freejoint name="ball_free_joint" />
      <geom name="the_ball" type="sphere" size="0.045" pos="0 0 -0.07" rgba="1 1 1 1.0" density="55" material="basketball_mat" />
    </body>
  </worldbody>

  <actuator>
    
    <motor name="motor_0" joint="wheel_joint_0" gear="1" ctrlrange="-10 10" />
    <motor name="motor_1" joint="wheel_joint_1" gear="1" ctrlrange="-10 10" />  
    <motor name="motor_2" joint="wheel_joint_2" gear="1" ctrlrange="-10 10" />
  </actuator>

  <contact>
    <pair name="non-isotropic0" geom1="the_ball" geom2="wheel_mesh_0" condim="3" friction="0.001 1.0" />
    <pair name="non-isotropic1" geom1="the_ball" geom2="wheel_mesh_1" condim="3" friction="0.001 1.0" />
    <pair name="non-isotropic2" geom1="the_ball" geom2="wheel_mesh_2" condim="3" friction="0.001 1.0" />
    <pair name="arrest0" geom1="the_ball" geom2="arrestor_0" condim="1"/>
    <pair name="arrest1" geom1="the_ball" geom2="arrestor_1" condim="1"/>
    <pair name="arrest2" geom1="the_ball" geom2="arrestor_2" condim="1"/>
  </contact>

  <sensor>
    <accelerometer name="imu_accel" site="imu_site" />
    <gyro name="imu_gyro" site="imu_site" />
  </sensor>

</mujoco>